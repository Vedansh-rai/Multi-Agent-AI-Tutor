# ===========================================
# Multimodal Math Mentor - Environment Config
# ===========================================
# Copy this file to .env and fill in your keys

# LLM Provider: "openai", "groq", or "gemini"
LLM_PROVIDER=gemini

# OpenAI API Key (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Groq API Key (required if LLM_PROVIDER=groq)
GROQ_API_KEY=gsk_your-groq-api-key-here

# Gemini API Key (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Model Configuration
# OpenAI models: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# Groq models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it
# Gemini models: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash
LLM_MODEL_NAME=gemini-2.5-flash
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Whisper model size: tiny, base, small, medium, large
WHISPER_MODEL_SIZE=base

# RAG Configuration
RAG_TOP_K=5
CHROMA_PERSIST_DIR=data/chroma_db

# Confidence Thresholds
VERIFIER_CONFIDENCE_THRESHOLD=0.7
OCR_CONFIDENCE_THRESHOLD=0.6

# Server
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
